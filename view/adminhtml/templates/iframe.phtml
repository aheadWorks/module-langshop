<?php
use Magento\Framework\Escaper;
use Magento\Backend\Block\Template;
use Aheadworks\Langshop\ViewModel\Page\Iframe;

/**
 * @var Template $block
 * @var Escaper $escaper
 * @var Iframe $viewModel
 */
$viewModel = $block->getData('view_model');
?>
<iframe src="<?= $escaper->escapeUrl($viewModel->getSourceUrl()) ?>"
        width="100%"
        height="780"
        frameborder="0"
        sandbox="allow-same-origin allow-scripts"
        scrolling="no"
        data-mage-init='{"Aheadworks_Langshop/js/iframe-bridge": {
            "redirectUrl": "<?= $escaper->escapeUrl($viewModel->getRedirectUrl()) ?>",
            "allowedHosts": <?= /* @noEscape */ json_encode($viewModel->getAllowedHosts()) ?>
        }}'
></iframe>
